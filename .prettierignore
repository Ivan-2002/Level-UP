# Prettier already skips everything in .gitignore (node_modules, the Prisma client, builds).

# Written by pnpm on every install: formatting it would be undone by the next install.
pnpm-lock.yaml

# Generated by Expo on start and lint. Git-ignored by apps/mobile/.gitignore, but Prettier
# only reads the root .gitignore, so a local check failed whenever Expo had written it.
apps/mobile/expo-env.d.ts

# Generated by Apple's Icon Composer.
apps/mobile/assets/expo.icon/

# Markdown: Prettier pads every table column, which turns each decision-log row into
# one very wide line. The docs stay hand-formatted.
*.md
