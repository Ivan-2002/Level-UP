# Copy this file to .env and change the values. Never commit .env.
POSTGRES_USER=levelup
POSTGRES_PASSWORD=levelup_dev_password
POSTGRES_DB=levelup
DATABASE_URL=postgresql://levelup:levelup_dev_password@localhost:5432/levelup

# Generate your own with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-32-chars-min
BETTER_AUTH_URL=http://localhost:3000
