// The LevelUp database schema. Models are added milestone by milestone,
// each with its own migration. See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication tables: OWNED BY BETTER AUTH.
// Field names must match what Better Auth expects. Don't add game data here;
// game data lives in Profile, so auth and the game stay separate.
// ---------------------------------------------------------------------------

model User {
  id            String               @id
  name          String
  email         String               @unique
  emailVerified Boolean              @default(false)
  image         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  workouts      Workout[]
  exercises     Exercise[] // custom exercises this user created (later)
  routines      Routine[]
  bodyweights   BodyweightEntry[]
  exercisePrefs ExercisePreference[]
  xpEvents      XpEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // a HASH, never the real password
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Game identity: OWNED BY US. Created on the "Create your character" screen.
// ---------------------------------------------------------------------------

// The unit a player types and reads weights in. Storage and maths are always kg.
enum WeightUnit {
  kg
  lb

  @@map("weight_unit")
}

model Profile {
  userId       String     @id
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  username     String     @unique @db.Citext // case-insensitive: "IvanLifts" and "ivanlifts" are the same name
  weeklyTarget Int        @default(3)
  weightUnit   WeightUnit @default(kg)
  totalXp      Int        @default(0) // cached sum of the XP ledger (added in Milestone 5)
  streakWeeks  Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("profile")
}

// Bodyweight over time: XP for bodyweight exercises uses the entry in effect on the
// workout's date, so changing your weight never rewrites old workouts' XP.
// Owned by the users module.
model BodyweightEntry {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kg         Decimal  @db.Decimal(7, 3) // 3 decimals: lb input converts back exactly (see units.ts)
  measuredOn DateTime @db.Date // a calendar day, no time
  createdAt  DateTime @default(now())

  // One entry per day: entering today's weight again updates it.
  @@unique([userId, measuredOn])
  @@map("bodyweight_entry")
}

// ---------------------------------------------------------------------------
// Exercise library: OWNED BY THE EXERCISES MODULE.
// Built-in exercises come from src/modules/exercises/exercise-catalog.ts (pnpm db:seed).
// ---------------------------------------------------------------------------

enum BodyPart {
  chest
  back
  shoulders
  arms
  core
  legs

  @@map("body_part")
}

enum Equipment {
  barbell
  dumbbell
  machine
  cable
  bodyweight
  kettlebell

  @@map("equipment")
}

// What the "reps" number of a set means for this exercise. Plank is held, not repeated.
// Compound = several joints, heavy (squat, bench); isolation = one joint (curl, raise).
// Drives the suggested rest range shown in the app.
enum Mechanic {
  compound
  isolation

  @@map("mechanic")
}

enum RepsUnit {
  reps
  seconds

  @@map("reps_unit")
}

model Exercise {
  id               String               @id @default(uuid(7)) @db.Uuid
  // Stable key for built-in exercises, so the seed can upsert ("barbell-back-squat").
  // Null for custom exercises; Postgres allows many NULLs in a unique column.
  slug             String?              @unique
  name             String
  muscleGroup      String // finer than bodyPart, for display ("Lats", "Quadriceps")
  bodyPart         BodyPart
  equipment        Equipment
  repsUnit         RepsUnit             @default(reps)
  mechanic         Mechanic             @default(isolation)
  suggestedRestSec Int                  @default(90) // rest priority: preference > routine > this > 120 s
  // XP tuning (Milestone 5): effective load = (weight + bodyweight x bodyweightRatio) x loadFactor
  loadFactor       Decimal              @db.Decimal(4, 2)
  bodyweightRatio  Decimal              @default(0) @db.Decimal(3, 2)
  isCustom         Boolean              @default(false)
  ownerId          String? // set only for custom exercises (later)
  owner            User?                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  usedIn           WorkoutExercise[]
  inRoutines       RoutineExercise[]
  preferences      ExercisePreference[]

  @@index([ownerId])
  @@map("exercise")
}

// The player's own choices for an exercise (rest time for now). Highest priority:
// preference > routine > exercise.suggestedRestSec > 120 s. Stored on the server so it
// follows the player to a new phone; written when a workout is finished.
model ExercisePreference {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String   @db.Uuid
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  restSec    Int
  updatedAt  DateTime @updatedAt

  @@id([userId, exerciseId])
  @@map("exercise_preference")
}

// ---------------------------------------------------------------------------
// Routines (saved plans): OWNED BY THE ROUTINES MODULE.
// A workout COPIES a routine's exercises when it starts, so editing or deleting a
// routine never changes history.
// ---------------------------------------------------------------------------

model Routine {
  id         String            @id @default(uuid(7)) @db.Uuid
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // Cached: when a workout from this routine last STARTED. Set by the workouts module at
  // Finish (never moved backwards), so listing routines needs no workout query.
  lastDoneAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  exercises  RoutineExercise[]
  workouts   Workout[]

  @@index([userId])
  @@map("routine")
}

model RoutineExercise {
  id         String   @id @default(uuid(7)) @db.Uuid
  routineId  String   @db.Uuid
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId String   @db.Uuid
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order      Int // 0-based
  targetSets Int
  targetReps Int
  restSec    Int? // null = use the exercise's suggestion

  @@unique([routineId, order])
  @@index([exerciseId])
  @@map("routine_exercise")
}

// ---------------------------------------------------------------------------
// Logged workouts: OWNED BY THE WORKOUTS MODULE.
// ---------------------------------------------------------------------------

model Workout {
  id         String            @id @default(uuid(7)) @db.Uuid
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Generated by the app when the workout starts; makes "Finish" safe to retry.
  clientId   String            @db.Uuid
  name       String?
  // Optional link to the routine it was started from. SetNull: deleting the routine
  // keeps the workout, the link just becomes empty.
  routineId  String?           @db.Uuid
  routine    Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)
  startedAt  DateTime
  finishedAt DateTime
  createdAt  DateTime          @default(now()) // when the server received it (may be later, offline)
  exercises  WorkoutExercise[]

  // Unique PER USER: a global key would let one user's retry match another user's workout.
  @@unique([userId, clientId])
  // Exactly the history query: this user's workouts, newest first, id as the tiebreaker.
  @@index([userId, startedAt(sort: Desc), id(sort: Desc)])
  @@index([routineId]) // "last done" per routine
  @@map("workout")
}

model WorkoutExercise {
  id         String       @id @default(uuid(7)) @db.Uuid
  workoutId  String       @db.Uuid
  workout    Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String       @db.Uuid
  // Restrict: an exercise that appears in someone's history can never be deleted.
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order      Int // 0-based position in the workout
  restSec    Int? // rest used in this workout; null for workouts logged before 4c
  sets       WorkoutSet[]

  @@unique([workoutId, order])
  @@index([exerciseId])
  @@map("workout_exercise")
}

model WorkoutSet {
  id                String          @id @default(uuid(7)) @db.Uuid
  workoutExerciseId String          @db.Uuid
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setOrder          Int // 0-based position within the exercise
  reps              Int
  weightKg          Decimal         @db.Decimal(7, 3) // added weight; 0 for plain bodyweight. 3 decimals: 135 lb round-trips
  completedAt       DateTime? // when it was ticked on the phone; null before 4c
  // Space for later anti-cheat checks: a flagged set earns no XP and isn't a PR until confirmed.
  isFlagged         Boolean         @default(false)
  flagReason        String?

  @@unique([workoutExerciseId, setOrder])
  @@map("workout_set")
}

// ---------------------------------------------------------------------------
// XP ledger: OWNED BY THE PROGRESSION MODULE.
// One row per XP gain. Total XP = the sum (cached on profile.totalXp); level is derived.
// ---------------------------------------------------------------------------

enum XpSource {
  workout_set // sourceId = workout_set.id
  weekly_target // later; sourceId must include the user, e.g. "<userId>:2026-W46"
  streak // later; same rule

  @@map("xp_source")
}

model XpEvent {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  source    XpSource
  sourceId  String
  bodyPart  BodyPart? // which avatar part it grows; null for bonuses
  createdAt DateTime  @default(now())

  // The same gain can never be recorded twice, even if Finish is sent again.
  @@unique([source, sourceId])
  @@index([userId, createdAt])
  @@map("xp_event")
}
