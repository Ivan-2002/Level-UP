# Copy to .env (same folder). Variables starting with EXPO_PUBLIC_ are built into the app,
# so NEVER put secrets here — anyone can read them from the app bundle.
#
# iOS simulator:       http://localhost:3000
# Android emulator:    http://10.0.2.2:3000
# Real phone (Expo Go): http://<your Mac's Wi-Fi IP>:3000, e.g. http://192.168.0.165:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
