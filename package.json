{
  "name": "level-up",
  "private": true,
  "description": "LevelUp \u2014 a gamified fitness app. Monorepo root.",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:api": "pnpm --filter api dev",
    "dev:mobile": "pnpm --filter mobile start",
    "typecheck": "pnpm -r --no-bail --no-sort --if-present run typecheck",
    "test": "pnpm -r --no-bail --no-sort --if-present run test",
    "lint": "pnpm -r --no-bail --no-sort --if-present run lint",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm format:check",
    "prepare": "simple-git-hooks",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript-eslint": "^8.73.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm typecheck && pnpm lint"
  }
}
